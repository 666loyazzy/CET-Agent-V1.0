# ---- LLM provider ----
# Options: anthropic | openai | deepseek
LLM_PROVIDER=anthropic

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- OpenAI-compatible (also works for DeepSeek etc.) ----
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Judge model (dictation grader) ----
# Latency-optimized settings for POST /api/vocab/judge. The main chat can
# stream token-by-token so it feels fast even on slow providers, but the
# judge has to wait for the whole JSON verdict — so route it through the
# fastest thing you have access to.
#
# JUDGE_PROVIDER: if blank, uses LLM_PROVIDER. Set to `anthropic` here to
# route only judgment through Anthropic Haiku (main chat stays unchanged).
# JUDGE_MODEL: if blank, defaults are:
#   openai on openai.com → gpt-4o-mini
#   anthropic            → claude-haiku-4-5-20251001
#   third-party proxy    → OPENAI_MODEL (unknown catalog)
# Override to whatever fast model your proxy exposes (e.g. gpt-3.5-turbo).
JUDGE_PROVIDER=
JUDGE_MODEL=
# Optional: separate key + base URL for judgment when JUDGE_PROVIDER is
# openai (or blank). Useful when judgment should go to a domestic proxy
# like DeepSeek (api.deepseek.com) while main chat stays on another host.
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_BASE_URL=

# ---- Embeddings (vector search) ----
# Any OpenAI-compatible /v1/embeddings endpoint works. Default is Alibaba
# DashScope (Aliyun Bailian) `text-embedding-v3`, which is cross-lingual
# (English queries and Chinese queries hit the same index sensibly) and
# reachable from mainland China without a proxy.
#
# One shared vector space is used across entity types — vocab today,
# listening / reading errors later — so you should only change model or
# dim when you are prepared to rebuild the whole index.
#
# Changing EMBEDDING_DIM requires dropping `vec_embedding_items` before
# restart (otherwise inserts fail on dim mismatch). See README
# "Regenerating embeddings".
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---- Skill knowledge base ----
# Path to the directory that contains SKILL.md.
# Defaults to ./skill inside the project.
SKILL_DIR=./skill

# ---- Server ----
HOST=127.0.0.1
PORT=8000
